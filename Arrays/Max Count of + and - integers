import java.util.*;
class Solution {
    public static int maximumCount(int[] nums) {
        int maxpos = 0;
        int maxneg = 0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>0){
                maxpos++;
            }
           else if(nums[i]<0){
                maxneg++;
            }
        }
        if(maxpos>maxneg){
            return maxpos;
        }
        else{
            return maxneg;
        }    
    }

    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        int n;
        n = sc.nextInt();
        int nums[] = new int[n];
        for(int i=0;i<nums.length;i++){
            nums[i] = sc.nextInt();
        }
        int x = maximumCount(nums);
        System.out.println(x);
    }
}
